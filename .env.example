# FamilyBridge — example environment. Placeholders only; copy to .env and fill in locally.
# Never commit .env. (Plan Appendix D)

# App
APP_ENV=development
SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64
ALLOWED_ORIGINS=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=900
INVITATION_TTL_DAYS=14
RESET_CODE_TTL_HOURS=48

# Database (Postgres password used by docker compose too)
POSTGRES_PASSWORD=change-me
# The API's own DML-only database role (Plan §5.12; created by `migrate`)
APP_DB_PASSWORD=change-me-too
DATABASE_URL=postgresql+psycopg://familybridge:change-me@localhost:5432/familybridge
TEST_DATABASE_URL=postgresql+psycopg://familybridge:change-me@localhost:5432/test_familybridge

# LLM (DeepSeek) — never commit real values
LLM_PROVIDER=deepseek             # deepseek | mock
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash    # D48; thinking mode is disabled by the client
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=2                 # 429/5xx/timeouts, exponential backoff with jitter
LLM_BREAKER_FAILURES=5            # consecutive failures before switching to fallbacks
LLM_BREAKER_COOLDOWN_SECONDS=60

# Knowledge base
KNOWLEDGE_SOURCE_DIR=../docs
KNOWLEDGE_WORK_DIR=../knowledge     # git-ignored: model cache, page renders, transcriptions
EMBEDDING_PROVIDER=fastembed       # fastembed | hash (offline test fake)
EMBEDDING_CACHE_DIR=../knowledge/models
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RAG_TOP_K=5
RAG_MIN_SCORE_ZH=0.83            # calibrated in Phase 3 for multilingual-e5-large (D46)
RAG_MIN_SCORE_EN=0.775

# Safety (placeholders — not clinically validated, O3/O12)
DIARY_URGE_THRESHOLD=7
SAFETY_ACK_SLA_HOURS=24

# Joint sessions
ROOM_DISCONNECT_PAUSE_SECONDS=60

# Adolescent lessons (placeholders — O21)
LESSON_MESSAGE_MAX_CHARS=500
LESSON_MAX_TURNS=30
SKILL_REPEAT_WINDOW=3
SKILL_TEST_MASTERY_CORRECT=4
SKILL_TEST_MAX_OUTPUT_TOKENS=8192

# Invitation/reset code checks per IP per 5 minutes (default 20). Raise ONLY on a local dev
# stack to run the full Playwright suite, which redeems more codes than this from one address.
# CODE_IP_MAX_ATTEMPTS=20
